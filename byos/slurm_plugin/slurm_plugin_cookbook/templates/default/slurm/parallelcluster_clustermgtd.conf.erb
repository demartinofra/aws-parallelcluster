[clustermgtd]
cluster_name = <%= node['byos']['cluster_name'] %>
region = <%= node['byos']['region'] %>
proxy = <%= node['byos']['proxy'] %>
heartbeat_file_path =  <%= node['slurm']['install_dir'] %>/etc/pcluster/.slurm_plugin/clustermgtd_heartbeat
dynamodb_table = <%= node['cluster']['ddb_table'] %>
hosted_zone = <%= node['cluster']['hosted_zone'] %>
dns_domain = <%= node['cluster']['dns_domain'] %>
use_private_hostname = <%= node['cluster']['use_private_hostname'] %>
head_node_private_ip = <%= node['ec2']['local_ipv4'] %>
head_node_hostname = <%= node['ec2']['local_hostname'] %>
